# Optional local LLM helper settings.
# The Chrome extension works without this helper; use it only when you want LLM suggestions.

LLM_PROVIDER=ollama
LLM_HELPER_HOST=127.0.0.1
LLM_HELPER_PORT=8765

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
