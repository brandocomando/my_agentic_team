{
  "manifest_version": 3,
  "name": "Survey Copilot",
  "version": "0.1.0",
  "description": "User-triggered survey autofill using a local Survey Copilot backend.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "content_scripts": [
    {
      "matches": [
        "https://app.paidviewpoint.com/*",
        "https://app.usertesting.com/my_dashboard/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
